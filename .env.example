# BharatEquity contracts — Monad Testnet only (chain 10143). Copy to .env (gitignored) and fill locally.

MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Deployment (script/deploy.sh). The deployer key lives in a Foundry keystore, NOT here:
#   cast wallet import bharatequity-deployer --interactive
DEPLOYER_ACCOUNT=bharatequity-deployer
ORACLE_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000   # public address only
INITIAL_RESERVE_WEI=0                                                # e.g. $(cast to-wei 2)

# Backend (NestJS) quote signer — store in a secret manager in production. Never commit / never expose to frontend.
ORACLE_SIGNER_PRIVATE_KEY=

# examples/e2e-demo.ts only: a funded testnet trader wallet
TRADER_PRIVATE_KEY=
FUND_RESERVE_MON=0
